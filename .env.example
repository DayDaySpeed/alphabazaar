# ── Buyer agent brain (optional) ───────────────────────────────────────────────
# If unset, AlphaBazaar falls back to a deterministic planner/synthesizer.
ANTHROPIC_API_KEY=
ALPHABAZAAR_MODEL=claude-opus-5

# ── Binance Agent OS ───────────────────────────────────────────────────────────
# mock     = fully offline synthetic portfolio + market data (default, safe for demos)
# snapshot = replay a real Agentic sub-account capture (alphabazaar/snapshot.json)
#            taken through a whitelisted MCP client — what the demo video uses
# live     = connect the MCP endpoint directly (CIMD OAuth). Blocked today: Binance
#            gates Agent OS to a fixed client allowlist (Claude, Claude Code, Codex,
#            ChatGPT, Cursor, VS Code); a custom agent gets "unsupported agent".
BINANCE_MODE=mock
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
# Optional: path to a sub-account capture for snapshot mode (defaults to
# alphabazaar/snapshot.json).
BINANCE_SNAPSHOT=
# Required for live MCP OAuth (CIMD). client_id inside the JSON must equal this URL.
# Example (public gist): https://gist.githubusercontent.com/DayDaySpeed/61fb65af38bab80835e451b648160e74/raw/alphabazaar-oauth-client-metadata.json
BINANCE_OAUTH_CLIENT_METADATA_URL=

# ── x402 payments ──────────────────────────────────────────────────────────────
# mock = simulated settlement (HMAC signature, fake tx hash), ledger still decrements
# live = real EIP-3009 settlement via a facilitator (needs the wallet key below +
#        test USDC on the payer address). Try: X402_MODE=live BINANCE_MODE=snapshot
#        then `python -m alphabazaar.cli x402-selftest` against a running seller.
X402_MODE=mock
X402_NETWORK=base-sepolia
# Payer wallet for live mode. EIP-3009 is gasless (the facilitator submits the tx)
# so this address needs test USDC but no ETH. Base Sepolia USDC faucet:
# https://faucet.circle.com  (contract 0x036CbD53842c5426634e7929541eC2318f3dCF7e)
X402_WALLET_PRIVATE_KEY=
X402_FACILITATOR_URL=https://x402.org/facilitator

# Daily spend cap mirrored from Binance x402 ($20/day). The agent stops buying
# once the ledger hits this.
X402_DAILY_CAP_USDC=20

# ── Seller agent discovery ─────────────────────────────────────────────────────
# The buyer reads alphabazaar/sellers.registry.json (ships the public onrender
# URLs). Leave these blank to use it. Set one to override a single entry's URL
# (run_demo.sh does this to point at localhost), or SELLER_REGISTRY to swap the
# whole directory (path or https URL).
SELLER_REGISTRY=
SELLER_FUNDING_URL=
SELLER_RISK_URL=
SELLER_MOMENTUM_URL=
# Live mode only: addresses the facilitator pays each seller at. The deployed
# sellers set these in render.yaml; only needed here when running a seller locally.
SELLER_FUNDING_PAY_TO=
SELLER_RISK_PAY_TO=
SELLER_MOMENTUM_PAY_TO=

# Shared secret used by the mock x402 handshake so sellers can "verify" a payment
# without a real chain. Ignored in live mode.
X402_MOCK_SECRET=alphabazaar-dev-secret
